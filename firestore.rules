rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    function weekDoc(weekId) {
      return get(/databases/$(database)/documents/weeks/$(weekId));
    }
    function beforeLock(weekId) {
      return !weekDoc(weekId).data.keys().hasAny(['lockAt']) ||
             request.time < weekDoc(weekId).data.lockAt;
    }

    function seasonPoolNotRevoked() {
      // Once a player has opted into the season-long ATS pot, a non-admin
      // update can never flip it back to false/absent. Admins can still
      // correct a mistaken opt-in if genuinely needed. Uses .get() with a
      // default so older docs that never had a seasonPool field don't
      // error out on evaluation.
      return isAdmin() ||
        resource.data.get('seasonPool', false) != true ||
        request.resource.data.get('seasonPool', false) == true;
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid &&
                    request.resource.data.role == "player";
      allow read: if signedIn();
      allow update: if signedIn() &&
        request.resource.data.role == resource.data.role &&
        seasonPoolNotRevoked() &&
        (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /weeks/{weekId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /games/{gameId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /entries/{uid} {
        // Own picks are always readable. Admins can read all.
        // Other players can read entries only after the weekly lock.
        allow read: if signedIn() &&
          (request.auth.uid == uid || isAdmin() || !beforeLock(weekId));

        allow create, update: if signedIn() &&
          ((request.auth.uid == uid && beforeLock(weekId)) || isAdmin());

        allow delete: if isAdmin();
      }
    }
  }
}